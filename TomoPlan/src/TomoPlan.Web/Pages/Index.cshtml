@page "{date:datetime?}"
@model IndexModel

<div class="">
    <!-- Date Selector Section -->
    <div class="d-flex justify-content-between align-items-center">
        <a id="prevDayBtn" class="btn btn-dark" asp-page="/" asp-page-handler="Get">
            <i class="fa-solid fa-chevron-left"></i>
        </a>
        <div class="text-center mb-2">
            <p class="text-uppercase fs-3 m-0">@Model.DailyPlanViewModel.DayOfWeek</p>
            <p class="fs-1 m-0" id="currentDate">@Model.DailyPlanViewModel.Date.ToString("MMM dd, yyyy")</p>
            <p class="fs-4 m-0">
                <span class="badge text-bg-dark">
                    @Model.DailyPlanViewModel.DayBadge
                </span>
            </p>
        </div>
        <a id="nextDayBtn" class="btn btn-dark" asp-page="/" asp-page-handler="Get" >
            <i class="fa-solid fa-chevron-right"></i>
        </a>
    </div>
    <hr>

    @if (@Model.DailyPlanViewModel.Tasks.Count != 0)
    {
        foreach (var task in @Model.DailyPlanViewModel.Tasks)
        {
            <partial name="_Task" model="task" />
        }
    }

    <!-- Add Block Section -->
    <div class="mt-4 w-100 p-3 d-flex align-items-center"
         data-bs-toggle="modal" data-bs-target="#taskModal"
         id="add-block-input"
         style="border: 2px dashed gray;">
        <span><i class="fa-solid fa-plus"></i></span>
        <p class="m-0 ms-2">Add a time block</p>
    </div>

    <div class="modal fade" id="taskModal" tabindex="-1" aria-labelledby="taskModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-page-handler="AddTimeBlock" method="POST">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="taskModalLabel">New Time Block</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row">
                            <div class="col-12 col-lg-6">
                                <label asp-for="TimeBlock.Start" class="form-label">From</label>
                                <input asp-for="TimeBlock.Start" class="form-control" type="time" />
                            </div>
                            <div class="col-12 col-lg-6">
                                <label asp-for="TimeBlock.End" class="form-label"></label>
                                <input asp-for="TimeBlock.End" class="form-control" type="time" />
                            </div>
                            <div class="col-12 mt-3">
                                <label asp-for="TimeBlock.Text" class="form-label"></label>
                                <textarea asp-for="TimeBlock.Text" class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer d-flex justify-content-start">
                        <button type="submit" class="btn btn-dark">Add Block</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const currentDate = document.getElementById("currentDate").innerText;
            const nextDayBtn = document.getElementById("nextDayBtn");
            const prevDayBtn = document.getElementById("prevDayBtn");
            
            nextDayBtn.addEventListener("click", function(event) {
                event.preventDefault();

                const nextDay = new Date(currentDate);
                nextDay.setDate(nextDay.getDate() + 1);

                const formatted = nextDay.toLocaleDateString();

                const url = new URL(nextDayBtn.href);
                url.searchParams.set("date", formatted);

                window.location.href = url.toString();
            });

            prevDayBtn.addEventListener("click", function(event) {
                event.preventDefault();

                const nextDay = new Date(currentDate);
                nextDay.setDate(nextDay.getDate() - 1);

                const formatted = nextDay.toLocaleDateString();

                const url = new URL(nextDayBtn.href);
                url.searchParams.set("date", formatted);

                window.location.href = url.toString();
            });
        });
    </script>
}