@model TomoPlan.Core.Data.Entities.DailyPlan;

@{
    ViewData["Title"] = "Tomorrow's Plan!";
}

<div id="planner" class="mt-3 container text-center my-2">
    <div id="planner-header" class="d-flex justify-content-between align-items-center">
        <button id="prevDay" class="icon-btn" aria-label="Previous day">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 18l-6-6 6-6" />
            </svg>
        </button>
        <div class="text-center">
            <div id="dayLabel" class="day-label" style="display: none;"></div>
            <div id="dateLabel" class="date-label" style="display: none;"></div>
        </div>
        <button id="nextDay" class="icon-btn" aria-label="Next day">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 18l6-6-6-6" />
            </svg>
        </button>
    </div>
    <div id="planner-add" class="mt-3 d-grid gap-2">
        <button id="addTaskBtn" class="btn btn-light border" data-bs-toggle="modal" data-bs-target="#addTaskModal">
            <i class="bi bi-plus"></i> Add
        </button>
    </div>
    <div class="grid-wrapper mt-3">
        <div id="grid" class="grid">
            <div id="grid-cursor"></div>
            @for (var i = 0; i <= 24; i++)
            {
                <div class="hour-row @(i == 24 ? "last": "")" id="hour-row-@(i)" style="top: @(i * 56)px"></div>
                <div class="hour-label" style="top: @(i == 0 ? 0 : (i * 56) - 7)px"></div>
            }
            @foreach (var task in @Model.Tasks)
            {
                <div class="task-block personal text-start p-2"
                     style="top: @(task.StartTime.Hour * 56)px; height: @(Math.Max(((task.EndTime.ToTimeSpan().TotalMinutes - task.StartTime.ToTimeSpan().TotalMinutes) / 60) * 56 - 2, 22))px"
                     role="button" tabindex="0">
                    <p class="m-0 fw-semibold" style="font-size: 0.9rem;">@task.Title</p>
                    <p class="m-0 fw-light" style="font-size: 0.9rem;">@task.StartTime.ToShortTimeString() -
                        @task.EndTime.ToShortTimeString()</p>
                    </div>
                }
            </div>
        </div>
    
        <div class="modal" id="addTaskModal" tabindex="-1" aria-labelledby="addTaskModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="addTaskModalLabel">Add task</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-start">
                        <form asp-controller="Home" asp-action="AddTask" method="post" id="addTaskForm">
                            <div class="row">
                                <div class="col-md-6 col-12">
                                    <label for="startTimeInput" class="form-label">Start</label>
                                    <input required name="StartTime" type="time" step="900" class="form-control"
                                           id="startTimeInput">
                                </div>
                                <div class="col-md-6 col-12">
                                    <label for="endTimeInput" class="form-label">End</label>
                                    <input required name="EndTime" type="time" step="900" class="form-control"
                                           id="endTimeInput">
                                </div>
                                <div class="col-12 mt-3">
                                    <label for="titleInput" class="form-label">Title</label>
                                    <input required name="Title" type="text" class="form-control" id="titleInput">
                                </div>
                                <div class="col-12 mt-3">
                                    <label for="taskText" class="form-label">Task</label>
                                    <textarea required name="Body" class="form-control" id="taskText" rows="3"></textarea>
                                </div>
                                <input type="hidden" name="PlanId" value="@Model.Id" />
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button id="confirmAddTaskBtn" type="button" class="btn btn-primary">Add</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            const [y, m, d] = '@Html.Raw(@Model.Date.ToString("yyyy-MM-dd"))'.split("-").map(Number);
            document.planDate = new Date(Date.UTC(y, m - 1, d));
        </script>
        <script type="module" src="~/js/plans/index.js" asp-append-version="true"></script>
    }
